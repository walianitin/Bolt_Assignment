# Vite client env (must be prefixed with VITE_ to be exposed to the browser)

# Dev server port
VITE_PORT=5173

# API base URL used by fetch calls
# Local:  /api  (Vite proxies to VITE_API_PROXY_TARGET)
# Prod (Vercel): set this in Vercel Project → Settings → Environment Variables
#   VITE_API_URL=https://YOUR-RENDER-API.onrender.com/api
# then Redeploy (Vite bakes this in at build time)
VITE_API_URL=/api

# Local Vite proxy target only (ignored on Vercel)
VITE_API_PROXY_TARGET=http://localhost:5000
