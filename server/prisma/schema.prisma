generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model RegisteredUser {
  id        String   @id @default(cuid())
  email     String   @unique
  hashedOtp String   @unique
  firstName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CheckoutForm {
  id        String   @id @default(cuid())
  email     String
  phone     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
