# ── App ──────────────────────────────────────────────
APP_NAME=BoltAssignment
NODE_ENV=development

# ── Server (Express) ─────────────────────────────────
# Port the API listens on
PORT=5000
# Allowed CORS origins — comma-separated (local Vite + Vercel frontends)
CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# ── Database (Postgres + Prisma) ─────────────────────
# Required. Neon / Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# ── Auth / OTP ───────────────────────────────────────
# bcrypt cost factor for hashing OTPs
BCRYPT_ROUNDS=10
# Token-bucket rate limit for /register and /login (per IP+email)
AUTH_RATE_LIMIT_CAPACITY=5
# Tokens refilled per second (0.0167 ≈ 1 token / 60s)
AUTH_RATE_LIMIT_REFILL_PER_SEC=0.0167

# ── Email (optional) ─────────────────────────────────
# If SMTP_* is empty, OTP is logged to the server console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Client (Vite) — used when running from root copy ─
# Prefer client/.env for the frontend; these are documented here for reference
VITE_PORT=5173
VITE_API_URL=http://localhost:5000/api
VITE_API_PROXY_TARGET=http://localhost:5000
